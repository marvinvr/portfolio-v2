# Never ship local or generated env files in the build context
.env
.env.*
!.env.example

# Dependencies and build output are produced inside the image
node_modules
build
.svelte-kit
package

# VCS / editor / OS noise
.git
.github
.vscode
.history
.DS_Store
*.log
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.sentryclirc

# Visual baselines/reports are mounted only in the isolated screenshot runner
visual
